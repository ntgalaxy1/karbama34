rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin verification
    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    // A collaborator role is minted only by the callable backend. The live
    // collaborator document is checked too, so deactivating an account takes
    // effect even before its custom token is refreshed.
    function isCollaborator() {
      return isSignedIn()
        && request.auth.token.karbamaRole == "collaborator"
        && exists(/databases/$(database)/documents/collaborators/$(request.auth.uid))
        && get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data.active == true;
    }

    function collaboratorOwnsApplicant(uid) {
      return isCollaborator()
        && exists(/databases/$(database)/documents/applicants/$(uid))
        && get(/databases/$(database)/documents/applicants/$(uid)).data.createdBy == request.auth.uid;
    }

    function collaboratorCreatedAccount(uid) {
      return isCollaborator()
        && exists(/databases/$(database)/documents/accounts/$(uid))
        && get(/databases/$(database)/documents/accounts/$(uid)).data.role == "applicant"
        && get(/databases/$(database)/documents/accounts/$(uid)).data.createdBy == request.auth.uid;
    }

    // Authentication credentials belong exclusively to Firebase Auth. Profile
    // documents must never become a second credential store.
    function hasNoAccountSecrets(data) {
      return !data.keys().hasAny([
        "password", "passwordHash", "passwordSalt", "credential", "secret"
      ]);
    }

    // Jobs: public read. Administrators manage all jobs; a collaborator can
    // manage only rows permanently stamped with their own UID.
    match /jobs/{jobId} {
      allow read: if isAdmin()
        || (isCollaborator() && resource.data.createdBy == request.auth.uid)
        || (isSignedIn() && !isCollaborator());
      allow create: if isAdmin()
        || (isCollaborator() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin()
        || (isCollaborator()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin()
        || (isCollaborator() && resource.data.createdBy == request.auth.uid);
    }

    // Job images: public read, admin write
    match /jobFiles/{fileId} {
      allow read: if isAdmin()
        || (isCollaborator() && resource.data.owner == request.auth.uid)
        || (isSignedIn() && !isCollaborator());

      function validJobImage() {
        return request.resource.data.contentType == "image/jpeg"
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 950000
          && request.resource.data.size is int
          && request.resource.data.size == request.resource.data.data.size()
          && request.resource.data.owner is string;
      }

      allow create: if validJobImage()
        && (isAdmin() || (isCollaborator() && request.resource.data.owner == request.auth.uid));
      allow update: if validJobImage()
        && (isAdmin() || (isCollaborator()
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner));
      allow delete: if isAdmin() || (isCollaborator() && resource.data.owner == request.auth.uid);
    }

    // Applicants
    match /applicants/{uid} {

      function paymentFieldsChanged() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            "paymentStatus",
            "paymentAt",
            "paymentMethod",
            "paymentReference",
            "paymentReceiptUrl"
          ]);
      }

      // Valid manual payment request
      function validManualRequest() {
        return resource.data.get("paymentStatus", "") != "paid"
          && request.resource.data.get("paymentStatus", "") == "pending"
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 "paymentStatus",
                 "paymentMethod",
                 "paymentReference",
                 "paymentReceiptUrl"
               ])
          && request.resource.data.get("paymentMethod", "") == "manual"
          && request.resource.data.get("paymentReference", null)
               is string
          && request.resource.data.paymentReference.size() >= 3
          && request.resource.data.paymentReference.size() <= 32
          && request.resource.data.get("paymentReceiptUrl", null)
               is string
          && request.resource.data.paymentReceiptUrl.size() > 0;
      }

      function validFreshApplicant() {
        return request.resource.data.get("paymentStatus", "") == ""
          && request.resource.data.get("paymentMethod", "") == ""
          && request.resource.data.get("paymentReference", "") == ""
          && request.resource.data.get("paymentReceiptUrl", "") == ""
          && !request.resource.data.keys().hasAny(["paymentAt"])
          && hasNoAccountSecrets(request.resource.data);
      }

      // A job seeker creates their own record. A collaborator may create only
      // the Auth account already allocated to them by the trusted callable.
      allow create: if isSignedIn()
        && validFreshApplicant()
        && (
          (request.auth.uid == uid && request.resource.data.get("createdBy", "") == "")
          || (
            collaboratorCreatedAccount(uid)
            && request.resource.data.uid == uid
            && request.resource.data.get("createdBy", "") == request.auth.uid
          )
        );

      // Owner, originating collaborator, or main admin reads the profile.
      allow read: if isSignedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
          || (isCollaborator() && resource.data.createdBy == request.auth.uid)
        );

      // Admin can update. The owner keeps the existing restricted payment path;
      // collaborator edits are limited to their own created applicant and can
      // never reassign it, change payment fields, or revive a legacy password hash.
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            request.auth.uid == uid
            && request.resource.data.get("createdBy", "") == resource.data.get("createdBy", "")
            && hasNoAccountSecrets(request.resource.data)
            && (
              !paymentFieldsChanged()
              || validManualRequest()
            )
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(["paymentAt"])
          )
          || (
            collaboratorOwnsApplicant(uid)
            && request.resource.data.get("createdBy", "") == resource.data.get("createdBy", "")
            && !paymentFieldsChanged()
            && hasNoAccountSecrets(request.resource.data)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(["paymentAt"])
          )
        );

      // Only admin deletes applicant profile
      allow delete: if isAdmin();
    }

    // Payment sessions: owner read, no client writes
    match /paymentSessions/{sessionId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow write: if false;
    }

    // Likes: owner or admin reads and deletes
    match /likes/{docId} {
      allow read: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
          || collaboratorOwnsApplicant(resource.data.applicantId)
        );

      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid;

      allow delete: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
          || collaboratorOwnsApplicant(resource.data.applicantId)
        );

      allow update: if false;
    }

    // Applications: owner or admin reads and deletes
    match /applications/{docId} {
      allow read: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
          || collaboratorOwnsApplicant(resource.data.applicantId)
        );

      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid;

      allow delete: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
          || collaboratorOwnsApplicant(resource.data.applicantId)
        );

      allow update: if false;
    }

    // Applicant images and payment receipts
    // Path: applicantFiles/{uid}/files/{kind}
    match /applicantFiles/{uid}/files/{kind} {

      // Owner, originating collaborator, or admin reads files.
      allow read: if isSignedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
          || (isCollaborator() && resource.data.createdBy == request.auth.uid)
        );

      // The collaborator can upload only for an applicant they created. The
      // payload's owner remains the applicant UID, never the collaborator UID.
      allow create, update: if isSignedIn()
        && (request.auth.uid == uid || collaboratorOwnsApplicant(uid))
        && kind in [
          "id_card",
          "body_photo",
          "payment_receipt"
        ]
        && request.resource.data.keys().hasAll([
          "owner",
          "contentType",
          "size",
          "data",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "owner",
          "contentType",
          "size",
          "data",
          "updatedAt"
        ])
        && request.resource.data.owner == uid
        && request.resource.data.contentType == "image/jpeg"
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 950000
        && request.resource.data.size is int
        && request.resource.data.size
             == request.resource.data.data.size();

      // Owner, originating collaborator, or admin deletes files
      allow delete: if isSignedIn()
        && (request.auth.uid == uid || isAdmin() || collaboratorOwnsApplicant(uid));
    }

    // Hotels shown in the routing tab. The main admin manages all records; a
    // collaborator can manage only an owned hotel, including city/address/location.
    match /hotels/{hotelId} {
      function validHotel() {
        return request.resource.data.keys().hasOnly([
            "countryCode", "cityId", "name", "address", "lat", "lon", "ownerUid", "active", "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "countryCode", "cityId", "name", "address", "lat", "lon", "ownerUid", "active", "updatedAt"
          ])
          && request.resource.data.countryCode == "TR"
          && request.resource.data.cityId is string
          && request.resource.data.cityId.size() >= 2
          && request.resource.data.cityId.size() <= 80
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 160
          && request.resource.data.address is string
          && request.resource.data.address.size() <= 500
          && request.resource.data.lat is number
          && request.resource.data.lat >= -90
          && request.resource.data.lat <= 90
          && request.resource.data.lon is number
          && request.resource.data.lon >= -180
          && request.resource.data.lon <= 180
          && request.resource.data.ownerUid is string
          && request.resource.data.ownerUid.size() <= 128
          && request.resource.data.active is bool
          && request.resource.data.updatedAt is int;
      }

      allow read: if isAdmin()
        || (isCollaborator() && resource.data.ownerUid == request.auth.uid)
        || (isSignedIn() && !isCollaborator());
      allow create: if validHotel()
        && (isAdmin() || (isCollaborator() && request.resource.data.ownerUid == request.auth.uid));
      allow update: if validHotel()
        && (isAdmin() || (
          isCollaborator()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
        ));
      allow delete: if isAdmin()
        || (isCollaborator() && resource.data.ownerUid == request.auth.uid);
    }

    // Duplicate registration prevention
    // Key format: nid_<sha256> or ph_<sha256>
    // Fields: owner, kind, createdAt
    match /uniqueKeys/{key} {

      function validKey() {
        return request.resource.data.keys().hasOnly([
            "owner",
            "kind",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "owner",
            "kind",
            "createdAt"
          ])
          && (
            request.resource.data.owner == request.auth.uid
            || collaboratorCreatedAccount(request.resource.data.owner)
          )
          && (
            (
              request.resource.data.kind == "nid"
              && key.matches("nid_[0-9a-f]{64}")
            )
            || (
              request.resource.data.kind == "phone"
              && key.matches("ph_[0-9a-f]{64}")
            )
          );
      }

      // Any signed-in user may check whether ONE key exists (needed for the
      // "already registered" message during registration). The document only
      // holds a hash + owner uid; listing all keys is admin-only.
      allow get: if isSignedIn();

      // Only admin may list keys
      allow list: if isAdmin();

      // Create a key owned by the authenticated user
      allow create: if isSignedIn()
        && validKey();

      // Owner or originating collaborator may update a candidate's key, never change its type.
      allow update: if isSignedIn()
        && (resource.data.owner == request.auth.uid || collaboratorCreatedAccount(resource.data.owner))
        && validKey()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.kind == resource.data.kind;

      // Owner, originating collaborator, or admin may delete
      allow delete: if isSignedIn()
        && (
          resource.data.owner == request.auth.uid
          || collaboratorCreatedAccount(resource.data.owner)
          || isAdmin()
        );
    }

    // Minimal in-app deletion intake. The applicant can initiate one request,
    // but only an administrator may review or complete it. No profile/document
    // contents are duplicated here: the document id and uid are the account UID.
    match /accountDeletionRequests/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/applicants/$(uid))
        && request.resource.data.keys().hasOnly(["uid", "status", "requestedAt"])
        && request.resource.data.keys().hasAll(["uid", "status", "requestedAt"])
        && request.resource.data.uid == uid
        && request.resource.data.status == "requested"
        && request.resource.data.requestedAt is int;
      // Fulfilment and any retention decision are an administrator operation.
      allow update, delete: if isAdmin();
    }

    // Account metadata is written exclusively by callable Functions. A user may
    // read only their own non-secret record; admins may audit all records.
    match /accounts/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Collaborator account metadata is also server-owned. The collaborator sees
    // their own active state; only the main admin can inspect the directory.
    match /collaborators/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Admin documents
    match /admins/{uid} {
      allow read: if isSignedIn()
        && request.auth.uid == uid;

      // Admin documents cannot be changed by client SDK
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
