rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin verification
    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    // Jobs: public read, admin write
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Job images: public read, admin write
    match /jobFiles/{fileId} {
      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.data.contentType == "image/jpeg"
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 950000
        && request.resource.data.size is int
        && request.resource.data.size
             == request.resource.data.data.size();

      allow delete: if isAdmin();
    }

    // Applicants
    match /applicants/{uid} {

      function paymentFieldsChanged() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            "paymentStatus",
            "paymentAt",
            "paymentMethod",
            "paymentReference",
            "paymentReceiptUrl"
          ]);
      }

      function validManualRequest() {
        return resource.data.get("paymentStatus", "") != "paid"
          && request.resource.data.get("paymentStatus", "")
               in ["", "pending"]
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 "paymentStatus",
                 "paymentMethod",
                 "paymentReference",
                 "paymentReceiptUrl"
               ])
          && (
            request.resource.data.get("paymentStatus", "") != "pending"
            || (
              request.resource.data.get("paymentMethod", "") == "manual"
              && request.resource.data.get("paymentReference", null)
                   is string
              && request.resource.data.paymentReference.size() >= 3
              && request.resource.data.paymentReference.size() <= 32
              && request.resource.data.get("paymentReceiptUrl", null)
                   is string
              && request.resource.data.paymentReceiptUrl.size() > 0
            )
          );
      }

      // Applicant creates own profile
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get("paymentStatus", "") == ""
        && !request.resource.data.keys().hasAny([
          "paymentAt"
        ]);

      // Owner or admin reads profile
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());

      // Admin can update; applicant has restricted updates
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            request.auth.uid == uid
            && (
              !paymentFieldsChanged()
              || validManualRequest()
            )
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(["paymentAt"])
          )
        );

      // Only admin deletes applicant profile
      allow delete: if isAdmin();
    }

    // Payment sessions: owner read, no client writes
    match /paymentSessions/{sessionId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow write: if false;
    }

    // Likes: owner or admin reads and deletes
    match /likes/{docId} {
      allow read: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
        );

      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid;

      allow delete: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
        );

      allow update: if false;
    }

    // Applications: owner or admin reads and deletes
    match /applications/{docId} {
      allow read: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
        );

      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid;

      allow delete: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
        );

      allow update: if false;
    }

    // Applicant images and payment receipts
    // Path: applicantFiles/{uid}/files/{kind}
    match /applicantFiles/{uid}/files/{kind} {

      // Owner or admin reads files
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());

      // Owner uploads or replaces permitted images
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && kind in [
          "id_card",
          "body_photo",
          "payment_receipt"
        ]
        && request.resource.data.keys().hasAll([
          "owner",
          "contentType",
          "size",
          "data",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "owner",
          "contentType",
          "size",
          "data",
          "updatedAt"
        ])
        && request.resource.data.owner == uid
        && request.resource.data.contentType == "image/jpeg"
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 950000
        && request.resource.data.size is int
        && request.resource.data.size
             == request.resource.data.data.size();

      // Owner or admin deletes files
      allow delete: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());
    }

    // Admin documents
    match /admins/{uid} {
      allow read: if isSignedIn()
        && request.auth.uid == uid;

      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
