rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin verification
    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    // Jobs: public read, admin write
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Job images: public read, admin write
    match /jobFiles/{fileId} {
      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.data.contentType == "image/jpeg"
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 950000
        && request.resource.data.size is int
        && request.resource.data.size
             == request.resource.data.data.size();

      allow delete: if isAdmin();
    }

    // Applicants
    match /applicants/{uid} {

      function paymentFieldsChanged() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            "paymentStatus",
            "paymentAt",
            "paymentMethod",
            "paymentReference",
            "paymentReceiptUrl"
          ]);
      }

      // Valid manual payment request
      function validManualRequest() {
        return resource.data.get("paymentStatus", "") != "paid"
          && request.resource.data.get("paymentStatus", "") == "pending"
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 "paymentStatus",
                 "paymentMethod",
                 "paymentReference",
                 "paymentReceiptUrl"
               ])
          && request.resource.data.get("paymentMethod", "") == "manual"
          && request.resource.data.get("paymentReference", null)
               is string
          && request.resource.data.paymentReference.size() >= 3
          && request.resource.data.paymentReference.size() <= 32
          && request.resource.data.get("paymentReceiptUrl", null)
               is string
          && request.resource.data.paymentReceiptUrl.size() > 0;
      }

      // Applicant creates own profile
      // Payment fields may only be absent or empty on create (the app sends ""),
      // and paymentAt is never allowed (admin only).
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get("paymentStatus", "") == ""
        && request.resource.data.get("paymentMethod", "") == ""
        && request.resource.data.get("paymentReference", "") == ""
        && request.resource.data.get("paymentReceiptUrl", "") == ""
        && !request.resource.data.keys().hasAny([
          "paymentAt"
        ]);

      // Owner or admin reads profile
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());

      // Admin can update; applicant has restricted payment updates
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            request.auth.uid == uid
            && (
              !paymentFieldsChanged()
              || validManualRequest()
            )
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(["paymentAt"])
          )
        );

      // Only admin deletes applicant profile
      allow delete: if isAdmin();
    }

    // Payment sessions: owner read, no client writes
    match /paymentSessions/{sessionId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow write: if false;
    }

    // Likes: owner or admin reads and deletes
    match /likes/{docId} {
      allow read: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
        );

      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid;

      allow delete: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
        );

      allow update: if false;
    }

    // Applications: owner or admin reads and deletes
    match /applications/{docId} {
      allow read: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
        );

      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid;

      allow delete: if isSignedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || isAdmin()
        );

      allow update: if false;
    }

    // Applicant images and payment receipts
    // Path: applicantFiles/{uid}/files/{kind}
    match /applicantFiles/{uid}/files/{kind} {

      // Owner or admin reads files
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());

      // Owner uploads or replaces permitted images
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && kind in [
          "id_card",
          "body_photo",
          "payment_receipt"
        ]
        && request.resource.data.keys().hasAll([
          "owner",
          "contentType",
          "size",
          "data",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "owner",
          "contentType",
          "size",
          "data",
          "updatedAt"
        ])
        && request.resource.data.owner == uid
        && request.resource.data.contentType == "image/jpeg"
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 950000
        && request.resource.data.size is int
        && request.resource.data.size
             == request.resource.data.data.size();

      // Owner or admin deletes files
      allow delete: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());
    }

    // Hotels shown in the routing tab. Any authenticated user may read the
    // manager-curated list; only an account listed in admins/{uid} may alter it.
    match /hotels/{hotelId} {
      function validHotel() {
        return request.resource.data.keys().hasOnly([
            "countryCode", "cityId", "name", "address", "lat", "lon", "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "countryCode", "cityId", "name", "address", "lat", "lon", "updatedAt"
          ])
          && request.resource.data.countryCode == "TR"
          && request.resource.data.cityId is string
          && request.resource.data.cityId.size() >= 2
          && request.resource.data.cityId.size() <= 80
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 160
          && request.resource.data.address is string
          && request.resource.data.address.size() <= 500
          && request.resource.data.lat is number
          && request.resource.data.lat >= -90
          && request.resource.data.lat <= 90
          && request.resource.data.lon is number
          && request.resource.data.lon >= -180
          && request.resource.data.lon <= 180
          && request.resource.data.updatedAt is int;
      }

      allow read: if isSignedIn();
      allow create, update: if isAdmin() && validHotel();
      allow delete: if isAdmin();
    }

    // Duplicate registration prevention
    // Key format: nid_<sha256> or ph_<sha256>
    // Fields: owner, kind, createdAt
    match /uniqueKeys/{key} {

      function validKey() {
        return request.resource.data.keys().hasOnly([
            "owner",
            "kind",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "owner",
            "kind",
            "createdAt"
          ])
          && request.resource.data.owner == request.auth.uid
          && (
            (
              request.resource.data.kind == "nid"
              && key.matches("nid_[0-9a-f]{64}")
            )
            || (
              request.resource.data.kind == "phone"
              && key.matches("ph_[0-9a-f]{64}")
            )
          );
      }

      // Any signed-in user may check whether ONE key exists (needed for the
      // "already registered" message during registration). The document only
      // holds a hash + owner uid; listing all keys is admin-only.
      allow get: if isSignedIn();

      // Only admin may list keys
      allow list: if isAdmin();

      // Create a key owned by the authenticated user
      allow create: if isSignedIn()
        && validKey();

      // Owner may update only their own key
      allow update: if isSignedIn()
        && resource.data.owner == request.auth.uid
        && validKey()
        && request.resource.data.kind == resource.data.kind;

      // Owner or admin may delete
      allow delete: if isSignedIn()
        && (
          resource.data.owner == request.auth.uid
          || isAdmin()
        );
    }

    // Admin documents
    match /admins/{uid} {
      allow read: if isSignedIn()
        && request.auth.uid == uid;

      // Admin documents cannot be changed by client SDK
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
