rules_version = '2';

// ==========================================================
//  قواعد امنیتی Firebase Storage — کارباما / Karbama
//  در Firebase Console → Storage → Rules این متن را جای‌گذاری و Publish کن.
//  v47: مدیر = کاربری که سند admins/{UID} در Firestore دارد (همان قانون ورود مدیر).
//  نیازی به نوشتن UID در این فایل نیست.
// ==========================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
             && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isImageUpTo5Mb() {
      return request.resource.size < 5 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    function isImageOrVideoUpTo25Mb() {
      return request.resource.size < 25 * 1024 * 1024
             && (request.resource.contentType.matches('image/.*')
                 || request.resource.contentType.matches('video/.*'));
    }

    // ---------- مدارک متقاضیان: پاسپورت، عکس تمام‌قد و رسید پرداخت v38 ----------
    match /applicants/{uid}/{fileName} {
      // خود فرد و مدیران می‌توانند ببینند
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // فقط خود فرد آپلود می‌کند؛ حداکثر ۵ مگابایت و فقط تصویر.
      // رسید پرداخت در مسیر applicants/{uid}/payment_receipt.jpg است و مدیر فقط خواندن دارد.
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && isImageUpTo5Mb();
    }

    // ---------- #29: عکس‌ها و ویدیوهای آگهی (که مدیر انتخاب می‌کند) ----------
    // مسیرها: jobs/{jobId}/job_<time>_<rand>.jpg | .mp4  و  jobs/{jobId}/poster_….jpg
    match /jobs/{jobId}/{fileName} {
      // همه‌ی کاربران عضو (کارجوها و مدیر) می‌توانند رسانه‌ی آگهی را ببینند
      allow read: if isSignedIn();

      // فقط مدیر می‌تواند عکس/ویدیوی آگهی را بگذارد یا پاک کند
      allow write: if isAdmin() && isImageOrVideoUpTo25Mb();
    }

    // بقیه‌ی مسیرها بسته است
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
